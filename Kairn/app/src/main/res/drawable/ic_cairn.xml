<?xml version="1.0" encoding="utf-8"?>
<!--
  Kairn launcher icon foreground.

  This is the kairn-mark.svg artwork converted to an Android VectorDrawable, because Android cannot
  render SVG and this vector is what actually ships in the APK. Same stones, same order, same
  gradients (light top -> darker bottom), same slight rotations, same ground line as the .svg art.

  Android gradients use absolute vector-space coordinates rather than SVG's objectBoundingBox, so
  each linear gradient's Y range is that stone's own top/bottom. Stone ends are fully rounded
  (rx = ry = half height), matching the SVG's rx="height/2".
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp" android:height="108dp"
    android:viewportWidth="108" android:viewportHeight="108">

    <!-- 96-unit mark art -> 108 viewport, scaled into the safe zone and centred (centre 54,54). -->
    <group android:scaleX="0.9" android:scaleY="0.9" android:translateX="10.8" android:translateY="5.4">

        <!-- ground line -->
        <path android:fillColor="#3A4046"
            android:pathData="M19.5,85 L76.5,85 A1.5,1.5 0 0 1 78,86.5 A1.5,1.5 0 0 1 76.5,88 L19.5,88 A1.5,1.5 0 0 1 18,86.5 A1.5,1.5 0 0 1 19.5,85 Z" />

        <!-- bottom stone -->
        <group android:rotation="-2" android:pivotX="48" android:pivotY="72">
            <path android:pathData="M24,62 L72,62 A10,10 0 0 1 82,72 A10,10 0 0 1 72,82 L24,82 A10,10 0 0 1 14,72 A10,10 0 0 1 24,62 Z">
                <aapt:attr name="android:fillColor">
                    <gradient android:type="linear"
                        android:startX="48" android:startY="62" android:endX="48" android:endY="82">
                        <item android:offset="0" android:color="#F1F4F2" />
                        <item android:offset="1" android:color="#BFC8CC" />
                    </gradient>
                </aapt:attr>
            </path>
        </group>

        <!-- middle stone -->
        <group android:rotation="3" android:pivotX="49" android:pivotY="50">
            <path android:pathData="M35.5,40 L62.5,40 A9.5,9.5 0 0 1 72,49.5 A9.5,9.5 0 0 1 62.5,59 L35.5,59 A9.5,9.5 0 0 1 26,49.5 A9.5,9.5 0 0 1 35.5,40 Z">
                <aapt:attr name="android:fillColor">
                    <gradient android:type="linear"
                        android:startX="49" android:startY="40" android:endX="49" android:endY="59">
                        <item android:offset="0" android:color="#C9D0D4" />
                        <item android:offset="1" android:color="#8F9AA0" />
                    </gradient>
                </aapt:attr>
            </path>
        </group>

        <!-- top stone -->
        <group android:rotation="-5" android:pivotX="51" android:pivotY="28">
            <path android:pathData="M46.5,20 L55.5,20 A8.5,8.5 0 0 1 64,28.5 A8.5,8.5 0 0 1 55.5,37 L46.5,37 A8.5,8.5 0 0 1 38,28.5 A8.5,8.5 0 0 1 46.5,20 Z">
                <aapt:attr name="android:fillColor">
                    <gradient android:type="linear"
                        android:startX="51" android:startY="20" android:endX="51" android:endY="37">
                        <item android:offset="0" android:color="#A6F0D8" />
                        <item android:offset="1" android:color="#5FCBAA" />
                    </gradient>
                </aapt:attr>
            </path>
        </group>

    </group>
</vector>
