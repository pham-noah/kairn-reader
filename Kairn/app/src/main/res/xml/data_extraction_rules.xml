<?xml version="1.0" encoding="utf-8"?>
<!--
  DEC-3 / DEC-12: nothing leaves the phone. Backups are an explicit action (Backup screen) to a file the
  user picks, never a cloud or device-transfer path, so both rulesets exclude everything.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
